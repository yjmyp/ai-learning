# Streamlit Cloud 部署：在 Settings → Secrets 里填这些（不要提交到 Git）
# 本地运行：把本文件改名为 secrets.toml 并填入真实 Key 即可
DEEPSEEK_API_KEY = "sk-你的key"

# 防公开链接被刷费用：每天模型调用次数上限（0 = 不限，默认 200）
DAILY_CALL_LIMIT = "200"

# ===== 数据持久化（可选，根治 Streamlit Cloud 重启丢数据）=====
# 1) 建一个私有仓库（如 yjmyp/offeragent-data）
# 2) GitHub → Settings → Developer settings → Personal access tokens → 生成 token（勾 repo）
# 3) 本地跑一次：set GITHUB_PAT=ghp_xxx && python sync_data.py push
# 4) 云端部署时填下面两项；app 启动检测到岗位库为空会自动从私有仓库拉取
GITHUB_PAT = "ghp_你的token"
DATA_REPO = "yjmyp/offeragent-data"
